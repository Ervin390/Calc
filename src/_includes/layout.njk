    <script>
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            var root = document.documentElement;
            function sync() {
                var dark = root.getAttribute('data-theme') === 'dark';
                btn.textContent = dark ? '☀️' : '🌙';
                btn.setAttribute('aria-pressed', String(dark));
            }
            sync();
            btn.addEventListener('click', function () {
                var dark = root.getAttribute('data-theme') === 'dark';
                if (dark) { root.removeAttribute('data-theme'); }
                else { root.setAttribute('data-theme', 'dark'); }
                try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
                sync();
            });
        })();
        (function () {
            var navToggle = document.getElementById('nav-toggle');
            var siteNav = document.getElementById('site-nav');
            var dropWrap = document.getElementById('nav-dropdown');
            var dropBtn = document.getElementById('nav-dropdown-toggle');
            if (!siteNav) return;

            if (dropBtn && dropWrap) {
                dropBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = dropWrap.classList.contains('open');
                    dropWrap.classList.toggle('open', !isOpen);
                    dropBtn.setAttribute('aria-expanded', !isOpen);
                });
            }

            if (navToggle) {
                navToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var expanded = navToggle.getAttribute('aria-expanded') === 'true';
                    navToggle.setAttribute('aria-expanded', !expanded);
                    siteNav.classList.toggle('expanded', !expanded);
                });
            }
            
            document.addEventListener('click', function (event) {
                if (dropWrap && !dropWrap.contains(event.target)) {
                    dropWrap.classList.remove('open');
                    if (dropBtn) dropBtn.setAttribute('aria-expanded', 'false');
                }
                if (navToggle && siteNav && !siteNav.contains(event.target) && !navToggle.contains(event.target) && siteNav.classList.contains('expanded')) {
                    navToggle.setAttribute('aria-expanded', 'false');
                    siteNav.classList.remove('expanded');
                }
            });
        })();
    </script>

<div id="cookie-banner" class="cookie-banner">
    <div class="cookie-box">

        <p class="cookie-text">
            We use cookies to improve your experience and analyze website traffic.
            By clicking <strong>Accept</strong>, you consent to analytics cookies.
        </p>

        <div class="cookie-buttons">
            <button id="cookie-reject" class="cookie-btn secondary">
                Only necessary
            </button>

            <button id="cookie-accept" class="cookie-btn primary">
                Accept all
            </button>
        </div>

    </div>
</div>

<script>
console.log("Cookie script loaded");

const cookieBanner = document.getElementById("cookie-banner");
const acceptButton = document.getElementById("cookie-accept");
const rejectButton = document.getElementById("cookie-reject");

const savedConsent = localStorage.getItem("cookieConsent");

// Ako je korisnik već odabrao, sakrij banner
if (savedConsent) {
    cookieBanner.style.display = "none";
}

// Accept
acceptButton.onclick = function () {

    console.log("ACCEPT clicked");

    localStorage.setItem("cookieConsent", "accepted");

    // Google Consent Mode update
    if (typeof gtag === "function") {
        gtag("consent", "update", {
            analytics_storage: "granted"
        });
    }

    cookieBanner.style.display = "none";
};


// Reject
rejectButton.onclick = function () {

